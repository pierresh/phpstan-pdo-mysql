parametersSchema:
    pdoMysql: structure([
        dialect: schema(anyOf('mysql', 'mssql', 'postgresql'))
    ])

parameters:
    pdoMysql:
        dialect: mysql

services:
    -
        class: Pierresh\PhpStanPdoMysql\SqlLinter\SqlLinterInterface
        factory: Pierresh\PhpStanPdoMysql\SqlLinter\SqlLinterFactory::create(%pdoMysql.dialect%)
    -
        class: Pierresh\PhpStanPdoMysql\Rules\ValidatePdoSqlSyntaxRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\ValidatePdoParameterBindingsRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\ValidateSelectColumnsMatchPhpDocRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\DetectSelfReferenceConditionsRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\DetectMySqlSpecificSyntaxRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\DetectInvalidTableReferencesRule
        tags:
            - phpstan.rules.rule
    -
        class: Pierresh\PhpStanPdoMysql\Rules\DetectTautologicalConditionsRule
        tags:
            - phpstan.rules.rule
